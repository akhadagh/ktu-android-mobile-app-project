<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Rounds only the top two corners of a ShapeableImageView.
         Used on every destination photo so the image and the card
         below it read as one rounded block, like in the original design. -->
    <style name="ShapeImageTopRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">12dp</item>
        <item name="cornerSizeTopRight">12dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>
